<UserControl x:Class="KCK_APP.WPF.Views.RegisterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid Background="White">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="500" Height="270">
            <TextBlock Text="Rejestracja" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="10"/>

            <TextBlock Text="Nazwa użytkownika" FontSize="10" HorizontalAlignment="Center"></TextBlock>
            <TextBox x:Name="UsernameBox" Margin="10" 
                     materialDesign:HintAssist.Hint="Nazwa użytkownika"
                     Style="{DynamicResource MaterialDesignOutlinedTextBox}" />

            <TextBlock Text="Hasło" FontSize="10" HorizontalAlignment="Center"></TextBlock>
            <PasswordBox x:Name="PasswordBox" Margin="10"
                         materialDesign:HintAssist.Hint="Hasło"
                         Style="{DynamicResource MaterialDesignOutlinedPasswordBox}" />

            <TextBlock Text="Potwierdź hasło" FontSize="10" HorizontalAlignment="Center"></TextBlock>
            <PasswordBox x:Name="ConfirmBox" Margin="10"
                         materialDesign:HintAssist.Hint="Potwierdź hasło"
                         Style="{DynamicResource MaterialDesignOutlinedPasswordBox}" />

            <Button Content="Zarejestruj" Margin="10"
                    Click="Register_Click"
                    Style="{DynamicResource MaterialDesignRaisedButton}"
                    HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>